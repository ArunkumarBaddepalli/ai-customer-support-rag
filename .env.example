# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required in production — signs login sessions. Use a long random string.
SECRET_KEY=change_me_to_a_long_random_string

# Postgres connection string. Leave unset locally and a SQLite file is used
# instead, so development needs no database setup.
#
# In production this must be set, otherwise signups are lost on every deploy —
# free hosting wipes the container's disk. The database does not have to live
# with the web host: a free Neon or Supabase instance works fine.
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password reset and email verification links. With no provider set, sends are
# logged to the console instead of failing — useful for local development.
#
# Brevo (recommended): 300 emails/day free and it delivers to ANY recipient.
# Sign up at brevo.com, verify one sender address by clicking the link it
# emails you, then create a key under Settings -> SMTP & API -> API Keys.
# No domain, no DNS, no card.
#   BREVO_API_KEY=xkeysib-xxxxxxxx
#   MAIL_FROM=SupportBot <your-verified-sender@gmail.com>
#
# Resend: also supported, but its shared sandbox sender only delivers to the
# address the Resend account was created with — every other signup silently
# receives nothing. A verified domain lifts that.
#   RESEND_API_KEY=re_xxxxxxxx
#   MAIL_FROM=SupportBot <onboarding@resend.dev>

# Test a real send once a key is set:
#   python mailer.py you@example.com

# Optional
PORT=5001
FLASK_DEBUG=false
